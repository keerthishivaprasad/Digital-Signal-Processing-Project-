A Digital Communication Simulator is one of the best MATLAB projects for ECE students because it covers digital modulation, noise, demodulation, and BER (Bit Error Rate). Below is a complete MATLAB program (around 220+ lines) that simulates BPSK, QPSK, and 16-QAM over an AWGN channel.

clc;
clear;
close all;

%% DIGITAL COMMUNICATION SIMULATOR

disp('========================================');
disp(' DIGITAL COMMUNICATION SIMULATOR');
disp('========================================');

%% Parameters

N = 10000;              % Number of bits
EbNo = 0:2:20;          % Eb/No range

bits = randi([0 1],N,1);

%% BPSK Simulation

BER_BPSK = zeros(size(EbNo));

for k = 1:length(EbNo)

    tx = 2*bits-1;

    rx = awgn(tx,EbNo(k),'measured');

    detected = rx>0;

    BER_BPSK(k)=sum(bits~=detected)/N;

end

%% QPSK Simulation

bitsQ = randi([0 1],N,1);

symbols = bi2de(reshape(bitsQ,2,[])','left-msb');

modQPSK = pskmod(symbols,4,pi/4);

BER_QPSK=zeros(size(EbNo));

for k=1:length(EbNo)

    rx = awgn(modQPSK,EbNo(k),'measured');

    demod = pskdemod(rx,4,pi/4);

    outBits = reshape(de2bi(demod,2,'left-msb')',[],1);

    BER_QPSK(k)=sum(bitsQ~=outBits)/length(bitsQ);

end

%% 16-QAM Simulation

bits16 = randi([0 1],N,1);

sym16 = bi2de(reshape(bits16,4,[])','left-msb');

qam = qammod(sym16,16);

BER_QAM=zeros(size(EbNo));

for k=1:length(EbNo)

    rx = awgn(qam,EbNo(k),'measured');

    demod = qamdemod(rx,16);

    outBits = reshape(de2bi(demod,4,'left-msb')',[],1);

    BER_QAM(k)=sum(bits16~=outBits)/length(bits16);

end

%% BER Plot

figure

semilogy(EbNo,BER_BPSK,'-or','LineWidth',2)

hold on

semilogy(EbNo,BER_QPSK,'-sb','LineWidth',2)

semilogy(EbNo,BER_QAM,'-^g','LineWidth',2)

xlabel('Eb/No (dB)')

ylabel('Bit Error Rate')

title('BER Performance')

legend('BPSK','QPSK','16-QAM')

grid on

%% Constellation Diagram

figure

subplot(1,2,1)

plot(real(modQPSK(1:500)),imag(modQPSK(1:500)),'.')

title('QPSK Constellation')

grid on

subplot(1,2,2)

plot(real(qam(1:500)),imag(qam(1:500)),'.')

title('16-QAM Constellation')

grid on

%% Signal Waveforms

figure

subplot(3,1,1)

stairs(bits(1:50),'LineWidth',2)

title('Input Binary Data')

ylim([-0.5 1.5])

grid on

subplot(3,1,2)

plot(tx(1:50),'LineWidth',2)

title('BPSK Modulated Signal')

grid on

subplot(3,1,3)

plot(rx(1:50),'LineWidth',2)

title('Received Signal')

grid on

%% Throughput Calculation

bitRate = 1000000;

throughput = bitRate*(1-BER_BPSK);

figure

plot(EbNo,throughput,'LineWidth',2)

xlabel('Eb/No (dB)')

ylabel('Throughput (bps)')

title('Throughput vs Eb/No')

grid on

%% Display Results

disp('=================================')

disp('SIMULATION RESULTS')

disp('=================================')

fprintf('Maximum BER (BPSK): %.6f\n',max(BER_BPSK));

fprintf('Minimum BER (BPSK): %.6f\n',min(BER_BPSK));

fprintf('Maximum BER (QPSK): %.6f\n',max(BER_QPSK));

fprintf('Minimum BER (QPSK): %.6f\n',min(BER_QPSK));

fprintf('Maximum BER (16QAM): %.6f\n',max(BER_QAM));

fprintf('Minimum BER (16QAM): %.6f\n',min(BER_QAM));

%% Save Results

Results = table(EbNo',BER_BPSK',BER_QPSK',BER_QAM',...
'VariableNames',{'EbNo','BPSK','QPSK','QAM16'});

writetable(Results,'CommunicationResults.xlsx');

disp('Results Saved Successfully');
